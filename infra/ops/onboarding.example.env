# Values for infra/ops/render-onboarding.sh: one router of one tenant (runbooks/pilot-onboarding.md,
# Routers). Copy this file, fill it in, render, then delete the copy and the rendered script once the
# router has run it: RADIUS_SECRET, REST_PASSWORD and SNMP_COMMUNITY are secrets. These are obvious fakes.
ROUTER_NAME=acme-utawala-01
ROUTER_ID=01900000-0000-7000-8000-0000000000c1
# The hub: corebalt-wg-hub public-key on the core host; the endpoint is a DNS name so a replacement
# host needs one record change; the tunnel address is wg_hub_address without its prefix.
HUB_A_PUBLIC_KEY=HUBAPUBLICKEYEXAMPLEEXAMPLEEXAMPLEEXAMPLE00=
HUB_A_ENDPOINT=hub-a.example.test
HUB_A_PORT=51820
HUB_A_TUNNEL_IP=10.200.0.1
# The router's tunnel address: the /32 registered in the admin app, with the hub's prefix here.
TUNNEL_ADDRESS=10.200.0.11/24
TUNNEL_IP=10.200.0.11
# Shown once when the router is registered (ADR 0009).
RADIUS_SECRET=example-radius-secret-not-real
# The ISP's own addressing on this router: customer pools and the PPPoE server's side.
FULL_POOL=10.10.0.10-10.10.0.250
RESTRICTED_POOL=10.11.0.10-10.11.0.250
PPP_LOCAL_ADDRESS=10.10.0.1
PPPOE_INTERFACE=ether2
# Where restricted customers may go: the public address pay.<domain> resolves to, plain HTTP on 80
# (the web front redirects it to the pay page).
PORTAL_ADDRESS=192.0.2.20
PAYPAGE_PORT=80
# The read-only REST user the tunnel worker polls with; entered on the router page afterwards.
REST_PASSWORD=example-rest-password-not-real
SNMP_COMMUNITY=example-snmp-community-not-real
# Who may reach the router's www (REST) service: the hub's network and the ISP's management network.
MANAGEMENT_ALLOWED=10.200.0.0/24,192.168.88.0/24
NTP_SERVERS=pool.ntp.org
