# Local development settings for infra/docker-compose.yml.
# Copy to infra/.env and change every password. .env is git-ignored; never commit real secrets.

COMPOSE_PROJECT_NAME=corebalt-isp

# PostgreSQL 17
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
ISP_DB_OWNER_PASSWORD=change-me-owner
ISP_DB_APP_PASSWORD=change-me-app
# The tunnel worker's role (ADR 0011). A volume created before step 8 needs the role created once by
# the superuser before migrating (infra/README.md, "The worker's database login").
ISP_DB_WORKER_PASSWORD=change-me-worker
RADIUS_DB_PASSWORD=change-me-radius

# Master key for tenant secrets (docs/07): base64 of 32 random bytes. Generate one per machine,
# e.g. PowerShell [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})) or openssl rand -base64 32.
# Losing it makes stored tenant secrets unreadable; they must then be entered again.
ISP_MASTER_KEY=change-me-base64-32-bytes

# Access-token signing key (ADR 0010): RSA, base64 PKCS#8, only ever in the environment. Generate or
# rotate it with infra/scripts/jwt-key.(ps1|sh), which writes these three lines of infra/.env; a
# rotation moves the old public key to ISP_JWT_RETIRED_KEYS so nobody is signed out.
ISP_JWT_KID=change-me-run-jwt-key
ISP_JWT_PRIVATE_KEY=change-me-run-jwt-key
ISP_JWT_RETIRED_KEYS=
# Browser origins allowed to use the refresh cookie (admin and portal dev servers, Caddy).
ISP_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:8088
# First platform admin: created at startup only while none exists. Sign in, change the password,
# enrol TOTP, then empty both lines. Lost access later: infra/scripts/reset-platform-admin.
ISP_BOOTSTRAP_ADMIN_EMAIL=
ISP_BOOTSTRAP_ADMIN_PASSWORD=

# RabbitMQ 4
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=isp
RABBITMQ_PASSWORD=change-me-rabbit

# Redis 8
REDIS_PORT=6379

# Backend API
BACKEND_PORT=8080

# FreeRADIUS. RADIUS_LAB_SECRET is the shared secret of the network-lab NAS rows (radtest inside the
# container and the lab CHR); infra/lab/scripts/seed.ps1 loads it. At least 12 characters, letters
# and digits only. Developer machines only.
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_LAB_SECRET=change-me-lab-secret

# Caddy (reverse proxy for the API and the dev servers; 8089 serves the lab pay page)
CADDY_HTTP_PORT=8088
CADDY_PAYPAGE_PORT=8089

# WireGuard hub and network lab (infra/lab/README.md)
WG_PORT=51820
WG_HUB_ADDRESS=10.200.0.1/24
LAB_CHR_TUNNEL_IP=10.200.0.11
# Admin password set on the lab CHR VMs at first contact (infra/lab/scripts/lab.ps1).
LAB_CHR_ADMIN_PASSWORD=change-me-chr-admin

# M-Pesa (docs/05). CALLBACK_BASE_URL is the public HTTPS origin Safaricom calls: in the lab a tunnel
# to Caddy, e.g. cloudflared tunnel --url http://localhost:8088. The DARAJA_SANDBOX_* values come from
# your app on developer.safaricom.co.ke and are used only by infra/scripts/daraja-sandbox.(ps1|sh).
# Leave them empty to skip the sandbox round-trip.
CALLBACK_BASE_URL=
DARAJA_SANDBOX_CONSUMER_KEY=
DARAJA_SANDBOX_CONSUMER_SECRET=
# Safaricom publishes the sandbox Lipa na M-Pesa shortcode, passkey and test MSISDN with the app.
DARAJA_SANDBOX_SHORTCODE=174379
DARAJA_SANDBOX_PASSKEY=
DARAJA_SANDBOX_TEST_MSISDN=254708374149

# Africa's Talking sandbox (docs/04): used only by infra/scripts/at-sandbox.(ps1|sh). The API key
# comes from your sandbox app; the test number must be open in the AT simulator (E.164, +2547...).
# Tenants enter their own production key in the app (Settings > Notifications); never here.
AT_SANDBOX_API_KEY=
AT_SANDBOX_SENDER_ID=
AT_SANDBOX_TEST_NUMBER=
