# Managed by Ansible (roles/stack) from the inventory and its vault. Root only. The images come from
# images.env, written by the deploy playbook.
PLATFORM_DOMAIN={{ platform_domain }}
DATA_DIR={{ stack_data_dir }}
WG_HUB_IP={{ wg_hub_address | ansible.utils.ipaddr('address') }}
WORKER_HUB={{ stack_worker_hub }}
TLS_MODE={{ stack_tls_mode }}
ACME_EMAIL={{ acme_email }}
ACME_DNS_PROVIDER={{ stack_acme_dns_provider }}
ACME_DNS_API_TOKEN={{ vault_acme_dns_api_token }}
SMS_ALLOWLIST={{ stack_sms_allowlist }}
POSTGRES_SUPERUSER_PASSWORD={{ vault_postgres_superuser_password }}
ISP_DB_OWNER_PASSWORD={{ vault_db_owner_password }}
ISP_DB_APP_PASSWORD={{ vault_db_app_password }}
ISP_DB_WORKER_PASSWORD={{ vault_db_worker_password }}
RADIUS_DB_PASSWORD={{ vault_radius_db_password }}
RABBITMQ_PASSWORD={{ vault_rabbitmq_password }}
REDIS_PASSWORD={{ vault_redis_password }}
ISP_MASTER_KEY={{ vault_master_key }}
ISP_JWT_KID={{ vault_jwt_kid }}
ISP_JWT_PRIVATE_KEY={{ vault_jwt_private_key }}
ISP_JWT_RETIRED_KEYS={{ vault_jwt_retired_keys | default('') }}
ISP_BOOTSTRAP_ADMIN_EMAIL={{ vault_bootstrap_admin_email | default('') }}
ISP_BOOTSTRAP_ADMIN_PASSWORD={{ vault_bootstrap_admin_password | default('') }}
