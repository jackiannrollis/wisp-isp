# Live provider checks only. Copy to backend/.env; never commit credentials.
# These values are loaded by infra/scripts/*check.ps1 and daraja-sandbox.ps1, not by Spring Boot.
CELCOM_PARTNER_ID=
CELCOM_API_KEY=
CELCOM_SENDER_ID=
CELCOM_TEST_NUMBER=

DARAJA_SANDBOX_CONSUMER_KEY=
DARAJA_SANDBOX_CONSUMER_SECRET=
DARAJA_SANDBOX_PASSKEY=
# C2B and M-Pesa Express use distinct sandbox shortcodes (verified 2026-11-02).
# Override these if your Daraja simulator supplies different test values.
DARAJA_SANDBOX_C2B_SHORTCODE=600000
DARAJA_SANDBOX_STK_SHORTCODE=174379
DARAJA_SANDBOX_TEST_MSISDN=254708374149
