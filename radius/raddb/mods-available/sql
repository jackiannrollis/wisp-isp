# rlm_sql for the Corebalt ISP Platform (ADR 0004, N2).
#
# FreeRADIUS reads exactly two views from PostgreSQL and writes only radacct (accounting below):
#   radius_client_v3   routers (NAS) allowed to talk to this node
#   v_radius_auth_v7   check and reply attributes per username and router (T3)
# Both are defined by Flyway migrations in backend/; see docs/06-network-access-control.md.
# Views are versioned: switch the name here, never alter a view in place. The client list is
# radius_client_v3 (V202610191106); v_radius_auth_v4 (V202610201003) adds the pause clock (S7, E4);
# v_radius_auth_v5 (V202610201801) takes the profile from subscription_access(), shared with staff screens (S3);
# v_radius_auth_v6 (V202610211003) adds fair use and data caps through subscription_access_v2() (docs/09 step 8b);
# v_radius_auth_v7 (V202610211203) judges each line by the grace mode it was renewed under (S6).
#
# Connection settings come from the environment, never from this file:
#   RADIUS_DB_HOST, RADIUS_DB_PORT, RADIUS_DB_NAME, RADIUS_DB_USER, RADIUS_DB_PASSWORD

sql {
	dialect = "postgresql"
	driver = "rlm_sql_postgresql"

	server = "$ENV{RADIUS_DB_HOST}"
	port = "$ENV{RADIUS_DB_PORT}"
	login = "$ENV{RADIUS_DB_USER}"
	password = "$ENV{RADIUS_DB_PASSWORD}"
	radius_db = "$ENV{RADIUS_DB_NAME}"

	postgresql {
		send_application_name = yes
	}

	# Routers come from the database (reloaded on router onboarding).
	read_clients = yes
	client_table = "radius_client_v3"
	client_query = "\
		SELECT id, nasname, shortname, type, secret, server \
		FROM ${client_table}"

	# The view already resolves the access profile; there are no RADIUS groups.
	read_groups = no
	group_attribute = "SQL-Group"

	authcheck_table = "v_radius_auth_v7"
	authreply_table = "v_radius_auth_v7"

	# T3: a username only matches through a router of its own tenant; the view joins on nasname.
	# The router is identified by the packet's source address (its tunnel IP), which the client
	# cannot assert the way it can NAS-IP-Address.
	authorize_check_query = "\
		SELECT id, username, attribute, value, op \
		FROM ${authcheck_table} \
		WHERE username = '%{SQL-User-Name}' \
		  AND nasname = '%{Packet-Src-IP-Address}' \
		  AND kind = 'check' \
		ORDER BY id"

	authorize_reply_query = "\
		SELECT id, username, attribute, value, op \
		FROM ${authreply_table} \
		WHERE username = '%{SQL-User-Name}' \
		  AND nasname = '%{Packet-Src-IP-Address}' \
		  AND kind = 'reply' \
		ORDER BY id"

	# Accounting (docs/06 Accounting, N2, N7). radacct is partitioned by month; a trigger fills tenant,
	# router and subscription from the sending router's tunnel address, which is why nasipaddress is
	# Packet-Src-IP-Address and never the client-asserted NAS-IP-Address (T3). Octets fold in the
	# Gigawords counters. When a query changes no row, rlm_sql runs the next one: an update finds the
	# session, the insert covers a lost Start; ON CONFLICT makes a retransmitted packet harmless.
	acct_table1 = "radacct"
	acct_table2 = "radacct"
	postauth_table = "radpostauth"

	accounting {
		reference = "%{tolower:type.%{%{Acct-Status-Type}:-%{Request-Processing-Stage}}.query}"

		type {
			accounting-on {
				query = "UPDATE radacct SET acctstoptime = TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}), acctterminatecause = 'NAS-Reboot' WHERE nasipaddress = '%{Packet-Src-IP-Address}' AND acctstoptime IS NULL"
			}

			accounting-off {
				query = "UPDATE radacct SET acctstoptime = TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}), acctterminatecause = 'NAS-Reboot' WHERE nasipaddress = '%{Packet-Src-IP-Address}' AND acctstoptime IS NULL"
			}

			start {
				query = "UPDATE radacct SET acctupdatetime = TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}) WHERE acctuniqueid = '%{Acct-Unique-Session-Id}' AND acctstoptime IS NULL"
				query = "INSERT INTO radacct (acctsessionid, acctuniqueid, username, realm, nasipaddress, nasportid, nasporttype, acctstarttime, acctupdatetime, acctstoptime, acctsessiontime, acctauthentic, connectinfo_start, connectinfo_stop, acctinputoctets, acctoutputoctets, calledstationid, callingstationid, acctterminatecause, servicetype, framedprotocol, framedipaddress) VALUES ('%{Acct-Session-Id}', '%{Acct-Unique-Session-Id}', '%{SQL-User-Name}', NULLIF('%{Realm}', ''), '%{Packet-Src-IP-Address}', NULLIF('%{%{NAS-Port-ID}:-%{NAS-Port}}', ''), NULLIF('%{NAS-Port-Type}', ''), TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}), TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}), NULL, NULL, NULLIF('%{Acct-Authentic}', ''), NULLIF('%{Connect-Info}', ''), NULL, 0, 0, NULLIF('%{Called-Station-Id}', ''), NULLIF('%{Calling-Station-Id}', ''), NULL, NULLIF('%{Service-Type}', ''), NULLIF('%{Framed-Protocol}', ''), NULLIF('%{Framed-IP-Address}', '')::inet) ON CONFLICT (acctuniqueid, acctstarttime) DO NOTHING"
			}

			interim-update {
				query = "UPDATE radacct SET acctupdatetime = TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}), acctstoptime = NULL, acctterminatecause = NULL, acctsessiontime = NULLIF('%{Acct-Session-Time}', '')::bigint, acctinputoctets = (('%{%{Acct-Input-Gigawords}:-0}'::bigint << 32) + '%{%{Acct-Input-Octets}:-0}'::bigint), acctoutputoctets = (('%{%{Acct-Output-Gigawords}:-0}'::bigint << 32) + '%{%{Acct-Output-Octets}:-0}'::bigint), framedipaddress = NULLIF('%{Framed-IP-Address}', '')::inet WHERE acctuniqueid = '%{Acct-Unique-Session-Id}' AND (acctstoptime IS NULL OR acctterminatecause = 'Stale')"
				query = "INSERT INTO radacct (acctsessionid, acctuniqueid, username, realm, nasipaddress, nasportid, nasporttype, acctstarttime, acctupdatetime, acctstoptime, acctsessiontime, acctauthentic, connectinfo_start, connectinfo_stop, acctinputoctets, acctoutputoctets, calledstationid, callingstationid, acctterminatecause, servicetype, framedprotocol, framedipaddress) VALUES ('%{Acct-Session-Id}', '%{Acct-Unique-Session-Id}', '%{SQL-User-Name}', NULLIF('%{Realm}', ''), '%{Packet-Src-IP-Address}', NULLIF('%{%{NAS-Port-ID}:-%{NAS-Port}}', ''), NULLIF('%{NAS-Port-Type}', ''), TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l} - %{%{Acct-Session-Time}:-0}), TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}), NULL, NULLIF('%{Acct-Session-Time}', '')::bigint, NULLIF('%{Acct-Authentic}', ''), NULLIF('%{Connect-Info}', ''), NULL, (('%{%{Acct-Input-Gigawords}:-0}'::bigint << 32) + '%{%{Acct-Input-Octets}:-0}'::bigint), (('%{%{Acct-Output-Gigawords}:-0}'::bigint << 32) + '%{%{Acct-Output-Octets}:-0}'::bigint), NULLIF('%{Called-Station-Id}', ''), NULLIF('%{Calling-Station-Id}', ''), NULL, NULLIF('%{Service-Type}', ''), NULLIF('%{Framed-Protocol}', ''), NULLIF('%{Framed-IP-Address}', '')::inet) ON CONFLICT (acctuniqueid, acctstarttime) DO NOTHING"
			}

			stop {
				query = "UPDATE radacct SET acctupdatetime = TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}), acctstoptime = TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}), acctsessiontime = NULLIF('%{Acct-Session-Time}', '')::bigint, acctinputoctets = (('%{%{Acct-Input-Gigawords}:-0}'::bigint << 32) + '%{%{Acct-Input-Octets}:-0}'::bigint), acctoutputoctets = (('%{%{Acct-Output-Gigawords}:-0}'::bigint << 32) + '%{%{Acct-Output-Octets}:-0}'::bigint), acctterminatecause = NULLIF('%{Acct-Terminate-Cause}', ''), connectinfo_stop = NULLIF('%{Connect-Info}', '') WHERE acctuniqueid = '%{Acct-Unique-Session-Id}' AND (acctstoptime IS NULL OR acctterminatecause = 'Stale')"
				query = "INSERT INTO radacct (acctsessionid, acctuniqueid, username, realm, nasipaddress, nasportid, nasporttype, acctstarttime, acctupdatetime, acctstoptime, acctsessiontime, acctauthentic, connectinfo_start, connectinfo_stop, acctinputoctets, acctoutputoctets, calledstationid, callingstationid, acctterminatecause, servicetype, framedprotocol, framedipaddress) VALUES ('%{Acct-Session-Id}', '%{Acct-Unique-Session-Id}', '%{SQL-User-Name}', NULLIF('%{Realm}', ''), '%{Packet-Src-IP-Address}', NULLIF('%{%{NAS-Port-ID}:-%{NAS-Port}}', ''), NULLIF('%{NAS-Port-Type}', ''), TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l} - %{%{Acct-Session-Time}:-0}), TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}), TO_TIMESTAMP(%{%{integer:Event-Timestamp}:-%l}), NULLIF('%{Acct-Session-Time}', '')::bigint, NULLIF('%{Acct-Authentic}', ''), NULLIF('%{Connect-Info}', ''), NULLIF('%{Connect-Info}', ''), (('%{%{Acct-Input-Gigawords}:-0}'::bigint << 32) + '%{%{Acct-Input-Octets}:-0}'::bigint), (('%{%{Acct-Output-Gigawords}:-0}'::bigint << 32) + '%{%{Acct-Output-Octets}:-0}'::bigint), NULLIF('%{Called-Station-Id}', ''), NULLIF('%{Calling-Station-Id}', ''), NULLIF('%{Acct-Terminate-Cause}', ''), NULLIF('%{Service-Type}', ''), NULLIF('%{Framed-Protocol}', ''), NULLIF('%{Framed-IP-Address}', '')::inet) ON CONFLICT (acctuniqueid, acctstarttime) DO NOTHING"
			}
		}
	}

	sql_user_name = "%{User-Name}"
	safe_characters = "@abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-_: /"

	pool {
		start = 2
		min = 2
		max = 16
		spare = 4
		uses = 0
		retry_delay = 30
		lifetime = 0
		idle_timeout = 60
		max_retries = 5
	}
}
